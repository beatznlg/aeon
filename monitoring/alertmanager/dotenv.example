# AEON OS Alertmanager Environment Variables
# Copy this file to monitoring/.env and fill in your credentials.
#
#   cp monitoring/alertmanager/dotenv.example monitoring/.env
#   # Edit monitoring/.env

# SMTP for email alerts
ALERTMANAGER_SMTP_HOST=smtp.gmail.com:587
ALERTMANAGER_SMTP_FROM=aeon-alerts@example.com
ALERTMANAGER_SMTP_USERNAME=your-email@gmail.com
ALERTMANAGER_SMTP_PASSWORD=your-app-password
ALERTMANAGER_EMAIL_TO=admin@example.com

# Slack for critical alerts
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxxx
ALERTMANAGER_SLACK_CHANNEL=#aeon-alerts
