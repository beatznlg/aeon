{
  "__inputs": [],
  "__requires": [],
  "title": "AEON OS - System Metrics",
  "version": 1,
  "uid": "aeon-os-metrics",
  "description": "Pre-built dashboard for AEON OS kernel metrics. Import into Grafana and set the Prometheus data source.",
  "schemaVersion": 36,
  "timezone": "browser",
  "editable": true,
  "tags": ["aeon", "monitoring", "metrics"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "value": "default" },
        "hide": 0,
        "label": "Data Source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "sum(rate(aeon_http_requests_total[5m]))",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 2,
      "title": "P99 / P95 / P50 Latency",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "aeon:http_request_latency_p99_5m",
          "legendFormat": "P99",
          "refId": "A"
        },
        {
          "expr": "aeon:http_request_latency_p95_5m",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "aeon:http_request_latency_p50_5m",
          "legendFormat": "P50",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "title": "Agent Tick Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "sum(rate(aeon_agent_ticks_total[5m]))",
          "legendFormat": "Total ticks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 4,
      "title": "Top Agent Apps by Tick Rate",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "topk(10, sum(rate(aeon_agent_ticks_total[5m])) by (app_id))",
          "legendFormat": "{{ app_id }}",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": {}, "indexByName": {}, "renameByName": { "Value": "Ticks/sec", "app_id": "App ID" } } }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate (5xx)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "aeon:error_ratio_5m",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Job Queue Size",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "aeon_job_queue_size",
          "legendFormat": "Queue depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP Status Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "sum(rate(aeon_http_requests_total[5m])) by (status)",
          "legendFormat": "{{ status }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 8,
      "title": "Workflow & Integration Run Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "${prometheus_datasource}",
      "targets": [
        {
          "expr": "sum(rate(aeon_workflow_runs_total[5m]))",
          "legendFormat": "Workflows",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aeon_integration_runs_total[5m]))",
          "legendFormat": "Integrations",
          "refId": "B"
        },
        {
          "expr": "sum(rate(aeon_swarm_runs_total[5m]))",
          "legendFormat": "Swarm",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ]
}
