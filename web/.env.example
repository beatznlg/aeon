# AEON web/ — Vercel deployment env vars
#
# Copy this file to `web/.env.local` for local dev (gitignored automatically).
# On Vercel, these go under Project Settings → Environment Variables.

# Required for both chat paths (HF Inference API direct + Gradio proxy).
# Reuse the same token as aeon.py for kernel-side Hub model downloads.
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for the Supabase "Memories" panel in the chat UI.
# Both of these are NEXT_PUBLIC_* — they ship in the browser bundle by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Required ONLY if you want Vercel to call the AEON kernel via HF Spaces
# instead of going directly through the HF Inference API. The URL must be
# your HF Space root (no trailing slash, no /chat appended).
# Leave unset to keep the HF-Inference-direct fallback.
AEON_HF_SPACE_URL=https://your-username-aeon-kernel.hf.space

# Server-only: used by /api/chat to do write-side Supabase logging without
# going through the browser. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
