{
  "name": "aeon-os",
  "version": "1.0.0",
  "private": true,
  "description": "AEON OS monorepo root. The Next.js frontend lives in web/.",
  "scripts": {
    "install": "npm --prefix web install",
    "build": "npm --prefix web run build && rm -rf .next && cp -R web/.next .next",
    "start": "npm --prefix web run start",
    "lint": "npm --prefix web run lint",
    "opencode": "opencode",
    "opencode:doctor": "opencode doctor"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "opencode-ai": "^1.18.21"
  }
}
