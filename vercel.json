{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/.next",
  "installCommand": "cd web && npm install",
  "functions": {
    "web/app/api/**/*.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aeon-backend.up.railway.app/:path*"
    }
  ]
}
