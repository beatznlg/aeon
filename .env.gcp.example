# AEON OS — Google Cloud production environment template
# Copy to /opt/aeon/.env on the Compute Engine VM and fill every required value.
# Never commit the real .env file.

POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
AEON_JWT_SECRET=CHANGE_ME_LONG_RANDOM
AEON_MASTER_KMS_KEY=CHANGE_ME_LONG_RANDOM
AUTH_SECRET=CHANGE_ME_LONG_RANDOM

# Public HTTPS hostname, e.g. aeon.example.com
AEON_DOMAIN=aeon.example.com
NEXTAUTH_URL=https://aeon.example.com
NEXT_PUBLIC_APP_URL=https://aeon.example.com
AEON_CORS_ALLOWED_ORIGINS=https://aeon.example.com

NEXT_PUBLIC_APP_NAME=AEON OS
AEON_LLM_PROVIDER=stub

# Optional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_TOKEN=

# Optional platform integrations
AEON_API_TOKEN=
AEON_ADMIN_EMAIL=
AEON_ADMIN_NAME=Admin
AEON_ADMIN_PASSWORD=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# Storage. Keep local for a first single-VM deployment; move to GCS when ready.
AEON_STORAGE_BACKEND=local
GCP_PROJECT_ID=
GCS_BUCKET=

# Optional S3-compatible storage compatibility settings
AWS_S3_BUCKET=
AWS_REGION=
