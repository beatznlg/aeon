# ─────────────────────────────────────────────────────────────────────────────
# AEON OS — environment template
# Copy to `.env` and fill in values:  cp env.example .env
# Never commit real secrets. Keep keys in your Keys/API Keys manager instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Auth.js v5 prefers AUTH_SECRET; NEXTAUTH_SECRET remains supported.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Strong backend JWT signing secret (production readiness requires this)
AEON_JWT_SECRET=
# Server-only token used by Next.js API routes to carry NextAuth identity to Flask.
# Generate with: openssl rand -base64 32
AEON_API_TOKEN=
# Master key for at-rest encryption of API keys / secrets
AEON_MASTER_KMS_KEY=

# ── Backend ──────────────────────────────────────────────────────────────────
AEON_PYTHON_URL=http://127.0.0.1:5000
# Upstream request budget (ms) for Next.js → Flask proxy calls; 0 disables.
AEON_PROXY_TIMEOUT_MS=45000
AEON_PYTHON_HOST=0.0.0.0
# AEON_PYTHON_PORT=5000            # defaults: platform PORT, else 5000
AEON_ENV=development               # set "production" in prod
AEON_CORS_ALLOWED_ORIGINS=http://localhost:3000
# AEON_DATABASE_URL=postgresql://aeon:aeon_dev_pass@localhost:5432/aeon
# AEON_REDIS_URL=redis://localhost:6379/0

# ── Admin configuration ─────────────────────────────────────────────────────
# Production: seed the backend with a generated Werkzeug hash.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=<werkzeug-password-hash>
# ADMIN_NAME=AEON Admin
# Local-only fallback (never use a plaintext password in production):
# ADMIN_PASSWORD=<local-development-password>

# ── OpenCode (AI coding agent CLI) ────────────────────────────────────────────
# OpenCode uses the same Anthropic key as the AEON backend. Set ANTHROPIC_API_KEY
# in the platform Keys tab; OpenCode reads it from the environment at runtime.
# Project config: opencode.json · agent instructions: AGENTS.md
# Run: npm run opencode (or `opencode` after `npm install -g opencode-ai`)
# ANTHROPIC_API_KEY=

# ── LLM providers (stub is the default and needs no key) ─────────────────────
AEON_LLM_PROVIDER=stub              # openai | anthropic | google | mistral | openrouter | ollama | lmstudio | vllm | hf | qwen | custom | stub
AEON_LLM_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=                 # optional provider-specific model override
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# HUGGINGFACE_TOKEN=
# AEON_CUSTOM_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AEON_CUSTOM_LLM_MODEL=
# AEON_CUSTOM_LLM_API_KEY=

# ── Supabase (optional users, automation rules, approvals) ───────────────────
# Public/browser-safe values (RLS applies):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only values (never prefix with NEXT_PUBLIC_):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (billing) ─────────────────────────────────────────────────────────
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_ENTERPRISE=

# ── Object storage (backup snapshots, DR artifacts) ──────────────────────────
# Backend: local (default), s3, or gcs
AEON_STORAGE_BACKEND=
# S3 settings (used when AEON_STORAGE_BACKEND=s3)
# AEON_S3_ENDPOINT=
# AEON_S3_BUCKET=
# AEON_S3_ACCESS_KEY=
# AEON_S3_SECRET_KEY=
# GCS settings (used when AEON_STORAGE_BACKEND=gcs)
# AEON_GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
