__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/
ENV/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# aeon.py writes this at runtime if invoked outside Colab.
aeon_drive/

# Sandbox artifacts (only if you ever run something throwaway here)
.cache/

# Node modules (anywhere)
node_modules/

# SDK build artifacts
sdk/typescript/dist/

# Next.js frontend build artifacts
.next/
web/node_modules/
web/.next/
web/out/
web/.env.local
!-web/.env.example

# Local secrets (root .env.local is bridged into web/ by scripts/start-preview.sh)
.env.local

# Local runtime state/logs
aeon_state/
server.log

# Local project snapshot/backup (never commit)
isolate/

# Security scan artifacts
bandit-report.json
scripts/output/
scripts/__pycache__/
